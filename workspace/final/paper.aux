\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Specific value recovery rates for our topic-bottleneck pipeline compared with DP-sanitized text attacked by various LLMs (Pang et al., 2024). Our approach achieves 2.3\% recovery (0\% with vocabulary exclusion), compared to 72--94\% for differential privacy methods. The dashed red line indicates the 10\% acceptable recovery threshold.}}{6}{figure.caption.26}\protected@file@percent }
\newlabel{fig:recovery}{{2}{6}{Specific value recovery rates for our topic-bottleneck pipeline compared with DP-sanitized text attacked by various LLMs (Pang et al., 2024). Our approach achieves 2.3\% recovery (0\% with vocabulary exclusion), compared to 72--94\% for differential privacy methods. The dashed red line indicates the 10\% acceptable recovery threshold}{figure.caption.26}{}}
