\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Performance metrics across four task types (n=12 each). Framework/reasoning, compliance, and procedural tasks achieve zero specific value recovery with strong BERTScore F1 (0.886--0.890). Entity-specific tasks show the expected quality-privacy trade-off with higher gold span overlap (0.65) and non-zero recovery (9.2\%). The dashed boundary highlights the operating envelope limit.}}{7}{figure.caption.32}\protected@file@percent }
\newlabel{fig:heatmap}{{4}{7}{Performance metrics across four task types (n=12 each). Framework/reasoning, compliance, and procedural tasks achieve zero specific value recovery with strong BERTScore F1 (0.886--0.890). Entity-specific tasks show the expected quality-privacy trade-off with higher gold span overlap (0.65) and non-zero recovery (9.2\%). The dashed boundary highlights the operating envelope limit}{figure.caption.32}{}}
