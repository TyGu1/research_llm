\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the topic-bottleneck query reformulation pipeline. The six-step process extracts a topic distribution from a sensitive (S2) question, generates generic S0 text, optionally applies vocabulary exclusion, generates and selects proxy questions, sends only S0 content to the cloud LLM, and synthesizes the final answer locally. Dashed red arrows indicate paths where the S2 question is used only locally. The trust boundary separates the local environment (green) from the cloud (blue).}}{4}{figure.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{4}{Overview of the topic-bottleneck query reformulation pipeline. The six-step process extracts a topic distribution from a sensitive (S2) question, generates generic S0 text, optionally applies vocabulary exclusion, generates and selects proxy questions, sends only S0 content to the cloud LLM, and synthesizes the final answer locally. Dashed red arrows indicate paths where the S2 question is used only locally. The trust boundary separates the local environment (green) from the cloud (blue)}{figure.caption.8}{}}
